# OpsRadar configuration — copy to `.env` before starting.
#
# The `docker-compose.yml` file refuses to start if the REQUIRED
# values below are missing. Generate real secrets locally — never
# commit a real `.env` to source control.

# ─── Environment ──────────────────────────────────────────────────────
# "development" | "production"
# In production mode the backend hard-fails at startup on any
# insecure default, so don't set this to "production" until you've
# set every REQUIRED value below.
ENV=development

# ─── Demo mode (optional) ─────────────────────────────────────────────
# Set to 1 to turn this stack into a locked-down public demo: the
# backend seeds a demo user + sample event logs on startup, the
# /auth/demo endpoint hands out anonymous JWTs, and a write-guard
# middleware rejects every POST/PUT/PATCH/DELETE outside the
# analytics allowlist. Leave unset for a normal self-host instance.
# See deploy/demo/README.md for the full demo deployment story.
DEMO_MODE=0

# ─── Sample-data seed (optional) ──────────────────────────────────────
# Set to 1 to populate the instance with three sample projects on
# first boot — the pm4py running-example, sepsis cases, and a
# container-logistics OCEL log. Unlike DEMO_MODE this leaves writes,
# uploads, and admin features fully enabled, so it's the right flag
# for trial deployments where customers want example data to click
# through. The seeder is idempotent (a restart never duplicates
# data) and creates a "Demo Visitor" viewer user that an admin can
# delete after the trial.
SEED_SAMPLE_DATA_ON_FIRST_BOOT=0

# ─── REQUIRED secrets ─────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
SECRET_KEY=

# Fernet key used to encrypt connector credentials, stored LLM API
# keys, and other sensitive fields at rest. Optional but strongly
# recommended — if unset, secret_box derives a key from SECRET_KEY
# which means rotating SECRET_KEY also invalidates all encrypted
# secrets. A dedicated key lets you rotate them independently.
# Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
OPS_RADAR_ENCRYPTION_KEY=

# ─── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=opsradar
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=opsradar

# ─── Redis ────────────────────────────────────────────────────────────
# Required — no default fallback. Celery uses Redis as its broker and
# an unauthenticated broker is a free denial-of-service vector.
# Generate with:  openssl rand -hex 24
REDIS_PASSWORD=

# ─── Upload directory + size limits ───────────────────────────────────
UPLOAD_DIR=/data/uploads
# 500 MB
MAX_UPLOAD_SIZE=524288000

# ─── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of origins that may call the API from a
# browser. Use the public URL of your SPA here, not localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost

# ─── App metadata ─────────────────────────────────────────────────────
APP_NAME=OpsRadar
APP_VERSION=0.1.0

# ─── Optional published image references ──────────────────────────────
# Leave these unset for normal local development. Set them when you want
# `docker compose` to use published GHCR images instead of local names.
# Example:
# OPSRADAR_BACKEND_IMAGE=ghcr.io/absolute-martial/ops-radar-backend:latest
# OPSRADAR_FRONTEND_IMAGE=ghcr.io/absolute-martial/ops-radar-frontend:latest
OPSRADAR_BACKEND_IMAGE=
OPSRADAR_FRONTEND_IMAGE=

# ─── Optional public-host configuration ──────────────────────────────
# The port where the SPA nginx container listens on the host.
OPS_RADAR_FRONTEND_PORT=3000

# The public port for the production edge proxy.
OPS_RADAR_PUBLIC_PORT=80

# ─── Observability (optional) ────────────────────────────────────────
# Sentry DSN. Leave empty to disable.
SENTRY_DSN=

# ─── SMTP (optional) ─────────────────────────────────────────────────
# Outbound email for password reset, scheduled reports, and alerts.
# Leave SMTP_HOST empty to disable email entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@opsradar.local

# ─── LLM provider (optional) ─────────────────────────────────────────
# You can configure the LLM provider either HERE (env-var style) or
# via the Settings page in the UI once logged in as admin. Values
# set in the Settings page override env vars.
#
# Providers: anthropic | openai | openrouter | ollama | null
# "null" returns templated responses, so the UI works end-to-end
# with no credentials configured. Great for demos and CI.
OPS_RADAR_LLM_PROVIDER=null

# OpenRouter — one API key unlocks dozens of models
# (Claude, GPT, Gemini, Llama, DeepSeek, Mistral, ...).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
# Optional ranking headers shown on OpenRouter's dashboards.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=OpsRadar

# Anthropic direct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI direct (and Azure OpenAI — set OPENAI_BASE_URL if needed)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama — run models locally, no API key needed. Point this at your
# Ollama host; the backend container needs to be able to reach it.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ─── Temporal (local compose scaffolding) ────────────────────────────
# The backend does not require these yet, but compose now provisions a
# local Temporal stack so the next Access Fastlane phase can wire in
# workflows without changing the infra contract again.
TEMPORAL_ENABLED=1
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_SERVER_URL=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=opsradar-access-fastlane
TEMPORAL_DEFAULT_NAMESPACE_RETENTION=72h
TEMPORAL_VERSION=1.29.6.1
TEMPORAL_UI_VERSION=2.49.1
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal
TEMPORAL_DB_NAME=temporal
TEMPORAL_VISIBILITY_DB_NAME=temporal_visibility
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8088
TEMPORAL_UI_CORS_ORIGINS=http://localhost:3000,http://localhost:8088

# ─── Novu (optional) ─────────────────────────────────────────────────
# Leave NOVU_API_KEY empty to disable delivery while keeping the env
# surface ready for the notification phase.
NOVU_ENABLED=0
NOVU_API_URL=https://api.novu.co
NOVU_API_KEY=
NOVU_APP_ID=

# ─── Casbin (optional) ───────────────────────────────────────────────
# Set these once a model/policy file or adapter is introduced.
CASBIN_ENABLED=0
CASBIN_MODEL=
CASBIN_POLICY=
